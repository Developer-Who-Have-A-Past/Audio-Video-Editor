{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "paths": {
      "@editor/core": ["./packages/core/src/index.ts"],
      "@editor/engine": ["./packages/engine/src/index.ts"],
      "@editor/ui": ["./packages/ui/src/index.ts"]
    }
  }
}
