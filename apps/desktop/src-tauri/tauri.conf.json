{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Editor",
  "version": "0.1.0",
  "identifier": "com.example.videoeditor",
  "build": {
    "beforeDevCommand": "npm run dev -w @editor/web",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build -w @editor/web",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [{ "title": "Video & Audio Editor", "width": 1280, "height": 800 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
